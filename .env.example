# Copy to .env and fill in. .env is gitignored - never commit a real token.

# Bulk data root. Must be outside the repository and outside OneDrive.
MAPGUARD_DATA=C:\osm-data

# Contact address embedded in the User-Agent of every OSM request.
# OSM is volunteer-run infrastructure; anonymous bulk traffic gets blocked.
MAPGUARD_CONTACT=ayushmgarg10@gmail.com

# OSMCha API token, from your OSMCha user page after logging in with an OSM account.
# Gates the Corpus B and D harmful labels. Free and instant; without it the API 401s.
OSMCHA_TOKEN=

# Weights and Biases, for the ablation grid.
WANDB_API_KEY=
